expression = "// Pixel coords
vec2 ip = floor(UV);

// Frame seed (discreto)
float seed = floor(T * 24.0);

// Mezcla (sin mover UV): convierte (x,y,seed) a un escalar bien mezclado
// (float-only \"pcg-ish\" hash)
vec3 p3 = fract(vec3(ip.x, ip.y, seed) * 0.1031);
p3 += dot(p3, p3.yzx + 33.33);
n_out = fract((p3.x + p3.y) * p3.z);
"

