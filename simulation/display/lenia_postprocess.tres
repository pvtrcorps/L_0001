// VectorDecompose:12
	float n_out12p0 = vec3(n_out7p0.xyz).x;
	float n_out12p1 = vec3(n_out7p0.xyz).y;
	float n_out12p2 = vec3(n_out7p0.xyz).z;


// VectorCompose:13
	vec3 n_out13p0 = vec3(n_out10p0, n_out11p1, n_out12p2);


// Output:0
	COLOR.rgb = n_out13p0;


}
