	float n_out11p1 = vec3(n_out6p0.xyz).y;
	float n_out11p2 = vec3(n_out6p0.xyz).z;


// FloatOp:27
	float n_out27p0 = n_out24p0 - n_out25p0;


// VectorOp:9
