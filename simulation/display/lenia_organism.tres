[sub_resource type="VisualShaderNodeFrame" id="VisualShaderNodeFrame_yt66g"]
size = Vector2(1244, 708)
title = "dXdY Normal"
attached_nodes = PackedInt32Array(53, 50, 49, 54, 48, 47, 196)

[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float camera_zoom;
uniform vec2 camera_pos;
uniform sampler2D tex_state : hint_default_black, repeat_enable;
uniform sampler2D tex_genome : hint_default_black, filter_nearest, repeat_enable;
uniform sampler2D tex_genome_ext : hint_default_black, filter_nearest, repeat_enable;
uniform sampler2D tex_detritus : hint_default_black, repeat_enable;
uniform sampler2D tex_frg_264;
uniform sampler2D tex_frg_178;
uniform vec4 u_select_vector : source_color;
uniform bool u_show_select;



void fragment() {
// ColorConstant:249
	vec4 n_out249p0 = vec4(0.010000, 0.010000, 0.010000, 1.000000);


// Input:10
	vec2 n_out10p0 = UV;


// VectorOp:14
	vec2 n_in14p1 = vec2(0.50000, 0.50000);
	vec2 n_out14p0 = n_out10p0 - n_in14p1;


// Input:11
	vec2 n_out11p0 = SCREEN_PIXEL_SIZE;


// VectorDecompose:15
	float n_out15p0 = n_out11p0.x;
	float n_out15p1 = n_out11p0.y;


// FloatOp:16
	float n_out16p0 = n_out15p1 / n_out15p0;


// VectorCompose:18
	float n_in18p1 = 1.00000;
	vec2 n_out18p0 = vec2(n_out16p0, n_in18p1);


// VectorOp:17
	vec2 n_out17p0 = n_out14p0 * n_out18p0;


// FloatParameter:13
	float n_out13p0 = camera_zoom;


// VectorOp:19
	vec2 n_out19p0 = n_out17p0 / vec2(n_out13p0);


// Vector2Parameter:12
	vec2 n_out12p0 = camera_pos;


// VectorOp:20
	vec2 n_out20p0 = n_out19p0 + n_out12p0;


// VectorOp:23
	vec2 n_in23p1 = vec2(0.50000, 0.50000);
	vec2 n_out23p0 = n_out20p0 + n_in23p1;


	float n_out79p0;
	vec2 n_out79p1;
	vec3 n_out79p2;
	vec4 n_out79p3;
	vec4 n_out79p4;
	vec2 n_out79p5;
	vec3 n_out79p6;
// Expression:79
	n_out79p0 = 0.0;
	n_out79p1 = vec2(0.0, 0.0);
	n_out79p2 = vec3(0.0, 0.0, 0.0);
	n_out79p3 = vec4(0.0, 0.0, 0.0, 0.0);
	n_out79p4 = vec4(0.0, 0.0, 0.0, 0.0);
	n_out79p5 = vec2(0.0, 0.0);
	n_out79p6 = vec3(0.0, 0.0, 0.0);
	{
		// --- CONFIGURACIÓN DE REJILLA ---
		vec2 s_res = vec2(textureSize(tex_state, 0));
		vec2 grid_pos = (n_out23p0 * s_res) - vec2(0.5);
		vec2 f = fract(grid_pos);
		vec2 i = floor(grid_pos);
		
		// 1. PESOS B-SPLINE Y SUS DERIVADAS (C2 Continuous)
		// Esto nos permite calcular normales \"pixel-perfect\" sin usar dFdx/dFdy.
		vec2 f2 = f * f;
		vec2 f3 = f2 * f;
		vec2 w0 = ( -f3 + 3.0*f2 - 3.0*f + 1.0 ) / 6.0;
		vec2 w1 = (  3.0*f3 - 6.0*f2 + 4.0        ) / 6.0;
		vec2 w2 = ( -3.0*f3 + 3.0*f2 + 3.0*f + 1.0 ) / 6.0;
		vec2 w3 = f3 / 6.0;
		
		// Derivadas de los pesos (para el gradiente analítico)
		vec2 dw0 = ( -3.0*f2 + 6.0*f - 3.0 ) / 6.0;
		vec2 dw1 = (  9.0*f2 - 12.0*f      ) / 6.0;
		vec2 dw2 = ( -9.0*f2 + 6.0*f + 3.0 ) / 6.0;
		vec2 dw3 = (  3.0*f2               ) / 6.0;
		
		// ACUMULADORES
		float r_mass = 0.0;
		vec2 grad = vec2(0.0);
		n_out79p3 = vec4(0.0);
		n_out79p4 = vec4(0.0);
		vec2 h_emit_v = vec2(0.0);
		vec2 h_det_v = vec2(0.0);
		
		// --- 16 Samples B-Spline ---
		// Reconstruimos TODO sincrónicamente para que no haya desajustes visuales.
		for(int y_off=-1; y_off<=2; y_off++){
		    float wy = (y_off==-1) ? w0.y : (y_off==0) ? w1.y : (y_off==1) ? w2.y : w3.y;
		    float dwy = (y_off==-1) ? dw0.y : (y_off==0) ? dw1.y : (y_off==1) ? dw2.y : dw3.y;
		    for(int x_off=-1; x_off<=2; x_off++){
		        float wx = (x_off==-1) ? w0.x : (x_off==0) ? w1.x : (x_off==1) ? w2.x : w3.x;
		        float dwx = (x_off==-1) ? dw0.x : (x_off==0) ? dw1.x : (x_off==1) ? dw2.x : dw3.x;
		        
		        vec2 uv_s = (i + vec2(float(x_off), float(y_off)) + vec2(0.5)) / s_res;
		        
		        // 1. Masa
		        float s_val = texture(tex_state, uv_s).r;
		        r_mass += s_val * wx * wy;
		        grad.x += s_val * dwx * wy;
		        grad.y += s_val * wx * dwy;
		        
		        // 2. Unpack Genes de esta muestra
		        vec4 g = texture(tex_genome, uv_s);
		        vec4 ex = texture(tex_genome_ext, uv_s);
		        uint b; vec2 v;
		        float w = wx * wy; // Weight for gene accumulation
		        
		        // Phys (R=Mu/Sigma, G=Rad/Visc)
		        b = floatBitsToUint(g.r) & 2147483647u;
		        n_out79p3.xy += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        b = floatBitsToUint(g.g) & 2147483647u;
		        n_out79p3.zw += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        
		        // Social (R=Aff/Rep, G=Dens/Mob)
		        b = floatBitsToUint(ex.r) & 2147483647u;
		        n_out79p4.xy += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        b = floatBitsToUint(ex.g) & 2147483647u;
		        n_out79p4.zw += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        
		        // Hues (A=Emit/Detect) - Circular accum
		        b = floatBitsToUint(ex.a) & 2147483647u;
		        v = vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0);
		        h_emit_v += vec2(cos(v.x*6.28), sin(v.x*6.28)) * w;
		        h_det_v += vec2(cos(v.y*6.28), sin(v.y*6.28)) * w;
		    }
		}
		
		// --- FINALIZACIÓN ---
		// Aplicamos el volumen orgánico a la masa
		//n_out79p0 = pow(max(0.0, r_mass), 0.6) * smoothstep(0.0, 0.1, r_mass);
		n_out79p0 = r_mass;
		
		// Normal Analítica (Escalamiento de gradiente por resolución)
		// Usamos un factor Z de ~0.2 para que el relieve sea visible pero suave.
		n_out79p6 = normalize(vec3(-grad.x, -grad.y, 0.1));
		
		// Resolvemos los Hues circulares
		n_out79p5.x = fract(atan(h_emit_v.y, h_emit_v.x) / 6.28318);
		n_out79p5.y = fract(atan(h_det_v.y, h_det_v.x) / 6.28318);
		
		// Datos directos (Detritus R=mass G=hue, Velocidad)
		vec3 raw_det = texture(tex_detritus, n_out23p0).rgb;
		n_out79p2 = (raw_det.r > 0.001) ? raw_det : vec3(0.0);
		n_out79p1 = texture(tex_state, n_out23p0).gb;
		
	}


// VectorDecompose:81
	float n_out81p0 = n_out79p5.x;
	float n_out81p1 = n_out79p5.y;


// Reroute:203
	float n_out203p0 = n_out79p0;


// Reroute:202
	float n_out202p0 = n_out203p0;


// FloatConstant:270
	float n_out270p0 = 0.003000;


// VectorOp:269
	vec2 n_out269p0 = n_out79p1 * vec2(n_out270p0);


// VectorOp:268
	vec2 n_out268p0 = n_out23p0 + n_out269p0;


// FloatConstant:266
	float n_out266p0 = 2.000000;


// VectorOp:265
	vec2 n_out265p0 = n_out268p0 * vec2(n_out266p0);


// VectorFunc:267
	vec2 n_out267p0 = fract(n_out265p0);


// Texture2D:264
	vec4 n_out264p0 = texture(tex_frg_264, n_out267p0);


// SmoothStep:170
	float n_in170p0 = 0.00000;
	float n_in170p1 = 0.10000;
	float n_out170p0 = smoothstep(n_in170p0, n_in170p1, n_out202p0);


// FloatOp:273
	float n_out273p0 = n_out264p0.x * n_out170p0;


// FloatOp:272
	float n_in272p1 = 0.50000;
	float n_out272p0 = n_out273p0 * n_in272p1;


// FloatOp:259
	float n_out259p0 = n_out202p0 + n_out272p0;


// FloatOp:319
	float n_in319p1 = 1.00000;
	float n_out319p0 = n_out259p0 * n_in319p1;


// VectorCompose:110
	float n_in110p1 = 0.80000;
	vec3 n_out110p0 = vec3(n_out81p0, n_in110p1, n_out319p0);


	vec3 n_out111p0;
// ColorFunc:111
	{
		vec3 c = n_out110p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out111p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// ColorOp:248
	vec3 n_out248p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out249p0.xyz)) * (vec3(1.0) - n_out111p0);


// VectorOp:129
	vec3 n_in129p1 = vec3(-1.00000, -1.00000, 1.00000);
	vec3 n_out129p0 = n_out79p6 * n_in129p1;


// FloatConstant:120
	float n_out120p0 = 0.722000;


// VectorOp:121
	vec3 n_out121p0 = n_out129p0 * vec3(n_out120p0);


// MultiplyAdd:107
	vec3 n_in107p1 = vec3(-0.50000, -0.50000, 0.50000);
	vec3 n_in107p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out107p0 = fma(n_out121p0, n_in107p1, n_in107p2);


// FloatConstant:181
	float n_out181p0 = 0.000000;


// Mix:179
	vec2 n_out179p0 = mix(vec2(n_out107p0.xy), n_out23p0, vec2(n_out181p0));


// Texture2D:178
	vec4 n_out178p0 = texture(tex_frg_178, n_out179p0);


// VectorOp:184
	vec3 n_out184p0 = vec3(n_out178p0.xyz) * vec3(n_out170p0);


// FloatConstant:214
	float n_out214p0 = 0.000000;


// VectorOp:213
	vec3 n_out213p0 = n_out184p0 * vec3(n_out214p0);


// Reroute:199
	vec3 n_out199p0 = n_out213p0;


// ColorOp:182
	vec3 n_out182p0 = vec3(1.0) - (vec3(1.0) - n_out248p0) * (vec3(1.0) - n_out199p0);


// VectorDecompose:314
	float n_out314p0 = n_out79p2.x;
	float n_out314p1 = n_out79p2.y;
	float n_out314p2 = n_out79p2.z;


// FloatConstant:72
	float n_out72p0 = 0.700000;


// VectorCompose:315
	vec3 n_out315p0 = vec3(n_out314p1, n_out72p0, n_out314p0);


	vec3 n_out316p0;
// ColorFunc:316
	{
		vec3 c = n_out315p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out316p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// FloatConstant:77
	float n_out77p0 = 0.250000;


// VectorOp:76
	vec3 n_out76p0 = n_out316p0 * vec3(n_out77p0);


	float n_out215p0;
// Remap:215
	float n_in215p1 = 0.00000;
	float n_in215p2 = 1.00000;
	float n_in215p3 = 1.00000;
	float n_in215p4 = 0.00000;
	{
		float __input_range = n_in215p2 - n_in215p1;
		float __output_range = n_in215p4 - n_in215p3;
		n_out215p0 = n_in215p3 + __output_range * ((n_out170p0 - n_in215p1) / __input_range);
	}


// Clamp:216
	float n_in216p1 = 0.00000;
	float n_in216p2 = 1.00000;
	float n_out216p0 = clamp(n_out215p0, n_in216p1, n_in216p2);


// VectorOp:204
	vec3 n_out204p0 = n_out76p0 * vec3(n_out216p0);


// VectorOp:321
	vec3 n_in321p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out321p0 = max(n_out204p0, n_in321p1);


// Reroute:322
	vec3 n_out322p0 = n_out321p0;


// Reroute:200
	vec3 n_out200p0 = n_out322p0;


// VectorOp:206
	vec4 n_out206p0 = vec4(n_out182p0, 0.0) + vec4(n_out200p0, 0.0);


// FloatConstant:223
	float n_out223p0 = 0.000000;


// DerivativeFunc:151
	float n_out151p0 = fwidthCoarse(n_out170p0);


// ParameterRef:195
	float n_out195p0 = camera_zoom;


// FloatOp:172
	float n_out172p0 = n_out151p0 * n_out195p0;


	float n_out219p0;
// Remap:219
	float n_in219p1 = 0.00000;
	float n_in219p2 = 1.00000;
	float n_in219p3 = 0.00000;
	float n_in219p4 = 1.00000;
	{
		float __input_range = n_in219p2 - n_in219p1;
		float __output_range = n_in219p4 - n_in219p3;
		n_out219p0 = n_in219p3 + __output_range * ((n_out172p0 - n_in219p1) / __input_range);
	}


// Clamp:323
	float n_in323p1 = 0.00000;
	float n_in323p2 = 1.00000;
	float n_out323p0 = clamp(n_out219p0, n_in323p1, n_in323p2);


// Mix:159
	float n_in159p0 = 0.00000;
	float n_in159p2 = 0.90000;
	float n_out159p0 = mix(n_in159p0, n_out323p0, n_in159p2);


// Clamp:224
	float n_in224p1 = 0.00000;
	float n_in224p2 = 1.00000;
	float n_out224p0 = clamp(n_out159p0, n_in224p1, n_in224p2);


// Reroute:201
	float n_out201p0 = n_out224p0;


// Mix:161
	vec3 n_out161p0 = mix(vec3(n_out206p0.xyz), vec3(n_out223p0), vec3(n_out201p0));


	vec3 n_out318p0;
// ColorFunc:318
	{
		vec3 c = clamp(n_out161p0, vec3(0.0), vec3(1.0));
		const vec3 a = vec3(0.055f);
		n_out318p0 = mix((vec3(1.0f) + a) * pow(c.rgb, vec3(1.0f / 2.4f)) - a, 12.92f * c.rgb, lessThan(c.rgb, vec3(0.0031308f)));
	}


// Reroute:186
	vec3 n_out186p0 = n_out318p0;


	vec3 n_out88p0;
// ColorFunc:88
	{
		vec3 c = n_out186p0;
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out88p0 = vec3(max2, max2, max2);
	}


// FloatConstant:90
	float n_out90p0 = 0.100000;


// VectorOp:89
	vec3 n_out89p0 = n_out88p0 * vec3(n_out90p0);


// Reroute:33
	vec2 n_out33p0 = n_out23p0;


	bool n_out29p0;
// Compare:29
	vec2 n_in29p1 = vec2(0.00000, 0.00000);
	{
		bvec2 _bv = greaterThan(n_out33p0, n_in29p1);
		n_out29p0 = all(_bv);
	}


	bool n_out30p0;
// Compare:30
	vec2 n_in30p1 = vec2(1.00000, 1.00000);
	{
		bvec2 _bv = lessThan(n_out33p0, n_in30p1);
		n_out30p0 = all(_bv);
	}


// FloatOp:31
	float n_out31p0 = (n_out29p0 ? 1.0 : 0.0) * (n_out30p0 ? 1.0 : 0.0);


// ColorParameter:295
	vec4 n_out295p0 = u_select_vector;


	float n_out294p0;
// Expression:294
	n_out294p0 = 0.0;
	{
		// Calculamos la distancia genética basada en los pesos originales
		float d = 0.0;
		d += abs(n_out79p3.x - n_out295p0.x) * 1.5; // mu
		d += abs(n_out79p3.y - n_out295p0.y) * 1.5; // sigma
		d += abs(n_out79p3.z - n_out295p0.z) * 1.0; // radius
		d += abs(n_out79p4.y - n_out295p0.w) * 1.0; // repulsion (index 9)
		// Generamos la máscara (1.0 si coincide, 0.0 si no)
		// El umbral 0.04 es el que usábamos para identificar la especie
		n_out294p0 = (d < 0.04 && n_out79p0 > 0.001) ? 1.0 : 0.0;
	}


// Input:301
	float n_out301p0 = TIME;


// FloatOp:302
	float n_in302p1 = 5.00000;
	float n_out302p0 = n_out301p0 * n_in302p1;


// FloatFunc:300
	float n_out300p0 = sin(n_out302p0);


// FloatOp:306
	float n_in306p1 = 3.14200;
	float n_out306p0 = n_out300p0 + n_in306p1;


// FloatOp:303
	float n_in303p1 = 1.00000;
	float n_out303p0 = n_out306p0 * n_in303p1;


// FloatOp:305
	float n_out305p0 = n_out294p0 * n_out303p0;


// FloatFunc:311
	float n_out311p0 = sqrt(n_out202p0);


// Clamp:304
	float n_in304p1 = 0.00000;
	float n_in304p2 = 1.00000;
	float n_out304p0 = clamp(n_out311p0, n_in304p1, n_in304p2);


// FloatOp:299
	float n_out299p0 = n_out305p0 * n_out304p0;


// BooleanParameter:296
	bool n_out296p0 = u_show_select;


// Mix:297
	float n_in297p0 = 1.00000;
	float n_out297p0 = mix(n_in297p0, n_out299p0, (n_out296p0 ? 1.0 : 0.0));


// FloatOp:298
	float n_out298p0 = n_out31p0 * n_out297p0;


// Mix:87
	vec3 n_out87p0 = mix(n_out89p0, n_out186p0, vec3(n_out298p0));


// Output:0
	COLOR.rgb = n_out87p0;


}
