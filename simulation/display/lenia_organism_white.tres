[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float camera_zoom;
uniform vec2 camera_pos;
uniform sampler2D tex_state : hint_default_black, repeat_enable;
uniform sampler2D tex_genome : hint_default_black, filter_nearest, repeat_enable;
uniform sampler2D tex_genome_ext : hint_default_black, filter_nearest, repeat_enable;
uniform sampler2D tex_signal : hint_default_black, repeat_enable;
uniform sampler2D tex_frg_178;



void fragment() {
// ColorConstant:312
	vec4 n_out312p0 = vec4(0.629675, 0.629675, 0.629675, 1.000000);


// Input:10
	vec2 n_out10p0 = UV;


// VectorOp:14
	vec2 n_in14p1 = vec2(0.50000, 0.50000);
	vec2 n_out14p0 = n_out10p0 - n_in14p1;


// Input:11
	vec2 n_out11p0 = SCREEN_PIXEL_SIZE;


// VectorDecompose:15
	float n_out15p0 = n_out11p0.x;
	float n_out15p1 = n_out11p0.y;


// FloatOp:16
	float n_out16p0 = n_out15p1 / n_out15p0;


// VectorCompose:18
	float n_in18p1 = 1.00000;
	vec2 n_out18p0 = vec2(n_out16p0, n_in18p1);


// VectorOp:17
	vec2 n_out17p0 = n_out14p0 * n_out18p0;


// FloatParameter:13
	float n_out13p0 = camera_zoom;


// VectorOp:19
	vec2 n_out19p0 = n_out17p0 / vec2(n_out13p0);


// Vector2Parameter:12
	vec2 n_out12p0 = camera_pos;


// VectorOp:20
	vec2 n_out20p0 = n_out19p0 + n_out12p0;


// VectorOp:23
	vec2 n_in23p1 = vec2(0.50000, 0.50000);
	vec2 n_out23p0 = n_out20p0 + n_in23p1;


	float n_out79p0;
	vec2 n_out79p1;
	vec3 n_out79p2;
	vec4 n_out79p3;
	vec4 n_out79p4;
	vec2 n_out79p5;
	vec3 n_out79p6;
// Expression:79
	n_out79p0 = 0.0;
	n_out79p1 = vec2(0.0, 0.0);
	n_out79p2 = vec3(0.0, 0.0, 0.0);
	n_out79p3 = vec4(0.0, 0.0, 0.0, 0.0);
	n_out79p4 = vec4(0.0, 0.0, 0.0, 0.0);
	n_out79p5 = vec2(0.0, 0.0);
	n_out79p6 = vec3(0.0, 0.0, 0.0);
	{
		// --- CONFIGURACIÓN DE REJILLA ---
		vec2 s_res = vec2(textureSize(tex_state, 0));
		vec2 grid_pos = (n_out23p0 * s_res) - vec2(0.5);
		vec2 f = fract(grid_pos);
		vec2 i = floor(grid_pos);
		
		// 1. PESOS B-SPLINE Y SUS DERIVADAS (C2 Continuous)
		// Esto nos permite calcular normales \"pixel-perfect\" sin usar dFdx/dFdy.
		vec2 f2 = f * f;
		vec2 f3 = f2 * f;
		vec2 w0 = ( -f3 + 3.0*f2 - 3.0*f + 1.0 ) / 6.0;
		vec2 w1 = (  3.0*f3 - 6.0*f2 + 4.0        ) / 6.0;
		vec2 w2 = ( -3.0*f3 + 3.0*f2 + 3.0*f + 1.0 ) / 6.0;
		vec2 w3 = f3 / 6.0;
		
		// Derivadas de los pesos (para el gradiente analítico)
		vec2 dw0 = ( -3.0*f2 + 6.0*f - 3.0 ) / 6.0;
		vec2 dw1 = (  9.0*f2 - 12.0*f      ) / 6.0;
		vec2 dw2 = ( -9.0*f2 + 6.0*f + 3.0 ) / 6.0;
		vec2 dw3 = (  3.0*f2               ) / 6.0;
		
		// ACUMULADORES
		float r_mass = 0.0;
		vec2 grad = vec2(0.0);
		n_out79p3 = vec4(0.0);
		n_out79p4 = vec4(0.0);
		vec2 h_emit_v = vec2(0.0);
		vec2 h_det_v = vec2(0.0);
		
		// --- 16 Samples B-Spline ---
		// Reconstruimos TODO sincrónicamente para que no haya desajustes visuales.
		for(int y_off=-1; y_off<=2; y_off++){
		    float wy = (y_off==-1) ? w0.y : (y_off==0) ? w1.y : (y_off==1) ? w2.y : w3.y;
		    float dwy = (y_off==-1) ? dw0.y : (y_off==0) ? dw1.y : (y_off==1) ? dw2.y : dw3.y;
		    for(int x_off=-1; x_off<=2; x_off++){
		        float wx = (x_off==-1) ? w0.x : (x_off==0) ? w1.x : (x_off==1) ? w2.x : w3.x;
		        float dwx = (x_off==-1) ? dw0.x : (x_off==0) ? dw1.x : (x_off==1) ? dw2.x : dw3.x;
		        
		        vec2 uv_s = (i + vec2(float(x_off), float(y_off)) + vec2(0.5)) / s_res;
		        
		        // 1. Masa
		        float s_val = texture(tex_state, uv_s).r;
		        r_mass += s_val * wx * wy;
		        grad.x += s_val * dwx * wy;
		        grad.y += s_val * wx * dwy;
		        
		        // 2. Unpack Genes de esta muestra
		        vec4 g = texture(tex_genome, uv_s);
		        vec4 ex = texture(tex_genome_ext, uv_s);
		        uint b; vec2 v;
		        float w = wx * wy; // Weight for gene accumulation
		        
		        // Phys (R=Mu/Sigma, G=Rad/Visc)
		        b = floatBitsToUint(g.r) & 2147483647u;
		        n_out79p3.xy += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        b = floatBitsToUint(g.g) & 2147483647u;
		        n_out79p3.zw += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        
		        // Social (R=Aff/Rep, G=Dens/Mob)
		        b = floatBitsToUint(ex.r) & 2147483647u;
		        n_out79p4.xy += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        b = floatBitsToUint(ex.g) & 2147483647u;
		        n_out79p4.zw += vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0) * w;
		        
		        // Hues (A=Emit/Detect) - Circular accum
		        b = floatBitsToUint(ex.a) & 2147483647u;
		        v = vec2(float((b >> 15u) & 32767u)/32767.0, float(b & 32767u)/32767.0);
		        h_emit_v += vec2(cos(v.x*6.28), sin(v.x*6.28)) * w;
		        h_det_v += vec2(cos(v.y*6.28), sin(v.y*6.28)) * w;
		    }
		}
		
		// --- FINALIZACIÓN ---
		// Aplicamos el volumen orgánico a la masa
		//n_out79p0 = pow(max(0.0, r_mass), 0.6) * smoothstep(0.0, 0.1, r_mass);
		n_out79p0 = r_mass;
		
		// Normal Analítica (Escalamiento de gradiente por resolución)
		// Usamos un factor Z de ~0.2 para que el relieve sea visible pero suave.
		n_out79p6 = normalize(vec3(-grad.x, -grad.y, 0.1));
		
		// Resolvemos los Hues circulares
		n_out79p5.x = fract(atan(h_emit_v.y, h_emit_v.x) / 6.28318);
		n_out79p5.y = fract(atan(h_det_v.y, h_det_v.x) / 6.28318);
		
		// Datos directos (Señales y Velocidad)
		n_out79p2 = texture(tex_signal, n_out23p0).rgb;
		n_out79p1 = texture(tex_state, n_out23p0).gb;
		
	}


// VectorDecompose:315
	float n_out315p0 = vec3(n_out79p5, 0.0).x;
	float n_out315p1 = vec3(n_out79p5, 0.0).y;
	float n_out315p2 = vec3(n_out79p5, 0.0).z;


// VectorCompose:316
	float n_in316p1 = 0.05000;
	float n_in316p2 = 0.10000;
	vec3 n_out316p0 = vec3(n_out315p0, n_in316p1, n_in316p2);


	vec3 n_out317p0;
// ColorFunc:317
	{
		vec3 c = n_out316p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out317p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Reroute:203
	float n_out203p0 = n_out79p0;


// Reroute:202
	float n_out202p0 = n_out203p0;


// FloatFunc:311
	float n_out311p0 = sqrt(n_out202p0);


// FloatOp:314
	float n_in314p1 = 0.50000;
	float n_out314p0 = pow(n_out311p0, n_in314p1);


// Mix:310
	vec3 n_out310p0 = mix(vec3(n_out312p0.xyz), n_out317p0, vec3(n_out314p0));


// VectorOp:129
	vec3 n_in129p1 = vec3(-1.00000, -1.00000, 1.00000);
	vec3 n_out129p0 = n_out79p6 * n_in129p1;


// FloatConstant:120
	float n_out120p0 = 0.722000;


// VectorOp:121
	vec3 n_out121p0 = n_out129p0 * vec3(n_out120p0);


// MultiplyAdd:107
	vec3 n_in107p1 = vec3(-0.50000, -0.50000, 0.50000);
	vec3 n_in107p2 = vec3(0.50000, 0.50000, 0.50000);
	vec3 n_out107p0 = fma(n_out121p0, n_in107p1, n_in107p2);


// FloatConstant:181
	float n_out181p0 = 0.000000;


// Mix:179
	vec2 n_out179p0 = mix(vec2(n_out107p0.xy), n_out23p0, vec2(n_out181p0));


// Texture2D:178
	vec4 n_out178p0 = texture(tex_frg_178, n_out179p0);


// SmoothStep:170
	float n_in170p0 = 0.00000;
	float n_in170p1 = 0.20000;
	float n_out170p0 = smoothstep(n_in170p0, n_in170p1, n_out202p0);


// VectorOp:184
	vec3 n_out184p0 = vec3(n_out178p0.xyz) * vec3(n_out170p0);


// FloatConstant:214
	float n_out214p0 = 0.000000;


// VectorOp:213
	vec3 n_out213p0 = n_out184p0 * vec3(n_out214p0);


// Reroute:199
	vec3 n_out199p0 = n_out213p0;


// ColorOp:182
	vec3 n_out182p0 = vec3(1.0) - (vec3(1.0) - n_out310p0) * (vec3(1.0) - n_out199p0);


// Reroute:207
	vec3 n_out207p0 = n_out79p2;


	vec3 n_out70p0;
// ColorFunc:70
	{
		vec3 c = n_out207p0;
		float max1 = max(c.r, c.g);
		float max2 = max(max1, c.b);
		n_out70p0 = vec3(max2, max2, max2);
	}


// FloatConstant:72
	float n_out72p0 = 0.485000;


// Mix:71
	vec3 n_out71p0 = mix(n_out70p0, n_out207p0, vec3(n_out72p0));


// FloatConstant:77
	float n_out77p0 = 0.150000;


// VectorOp:76
	vec3 n_out76p0 = n_out71p0 * vec3(n_out77p0);


	float n_out215p0;
// Remap:215
	float n_in215p1 = 0.00000;
	float n_in215p2 = 1.00000;
	float n_in215p3 = 1.00000;
	float n_in215p4 = 0.00000;
	{
		float __input_range = n_in215p2 - n_in215p1;
		float __output_range = n_in215p4 - n_in215p3;
		n_out215p0 = n_in215p3 + __output_range * ((n_out170p0 - n_in215p1) / __input_range);
	}


// Clamp:216
	float n_in216p1 = 0.00000;
	float n_in216p2 = 1.00000;
	float n_out216p0 = clamp(n_out215p0, n_in216p1, n_in216p2);


// VectorOp:204
	vec3 n_out204p0 = n_out76p0 * vec3(n_out216p0);


// Reroute:208
	vec3 n_out208p0 = n_out204p0;


// Reroute:200
	vec3 n_out200p0 = n_out208p0;


// VectorOp:206
	vec4 n_out206p0 = vec4(n_out182p0, 0.0) + vec4(n_out200p0, 0.0);


// Output:0
	COLOR.rgb = vec3(n_out206p0.xyz);


}
"
