nodes/fragment/294/node = SubResource("VisualShaderNodeExpression_yt66g")
nodes/fragment/294/position = Vector2(5820, 1060)
nodes/fragment/294/size = Vector2(472, 246)
nodes/fragment/294/input_ports = "0,5,p;1,5,s;2,5,sel;3,0,mass;"
nodes/fragment/294/output_ports = "0,0,mask;"
nodes/fragment/294/expression = "// Calculamos la distancia genética basada en los pesos originales
float d = 0.0;
d += abs(p.x - sel.x) * 1.5; // mu
d += abs(p.y - sel.y) * 1.5; // sigma
d += abs(p.z - sel.z) * 1.0; // radius
d += abs(s.y - sel.w) * 1.0; // repulsion (index 9)
// Generamos la máscara (1.0 si coincide, 0.0 si no)
// El umbral 0.04 es el que usábamos para identificar la especie
mask = (d < 0.04 && mass > 0.001) ? 1.0 : 0.0;"
