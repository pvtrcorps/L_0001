code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D screen_tex_frg_3 : hint_screen_texture;
uniform sampler2D screen_tex_frg_6 : hint_screen_texture;
uniform sampler2D screen_tex_frg_7 : hint_screen_texture;



void fragment() {
// Input:4
	vec2 n_out4p0 = UV;


// VectorOp:14
	vec2 n_in14p1 = vec2(0.50000, 0.50000);
	vec2 n_out14p0 = n_out4p0 - n_in14p1;


// FloatConstant:24
	float n_out24p0 = 1.000000;


// FloatConstant:25
	float n_out25p0 = 0.002000;


// Reroute:75
	float n_out75p0 = n_out25p0;


// FloatOp:26
	float n_out26p0 = n_out24p0 - n_out75p0;


// VectorOp:5
	vec2 n_out5p0 = n_out14p0 * vec2(n_out26p0);


// VectorOp:20
	vec2 n_in20p1 = vec2(0.50000, 0.50000);
	vec2 n_out20p0 = n_out5p0 + n_in20p1;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(screen_tex_frg_3, n_out20p0);


// VectorDecompose:10
	float n_out10p0 = vec3(n_out3p0.xyz).x;
	float n_out10p1 = vec3(n_out3p0.xyz).y;
	float n_out10p2 = vec3(n_out3p0.xyz).z;


// VectorLen:15
	float n_out15p0 = length(n_out14p0);


	float n_out16p0;
// Remap:16
	float n_in16p1 = 0.50000;
	float n_in16p2 = 1.00000;
	float n_in16p3 = 1.00000;
	float n_in16p4 = 0.00000;
	{
		float __input_range = n_in16p2 - n_in16p1;
		float __output_range = n_in16p4 - n_in16p3;
		n_out16p0 = n_in16p3 + __output_range * ((n_out15p0 - n_in16p1) / __input_range);
	}


// FloatOp:59
	float n_in59p1 = 0.50000;
	float n_out59p0 = pow(n_out16p0, n_in59p1);


// Clamp:60
	float n_in60p1 = 0.80000;
	float n_in60p2 = 1.00000;
	float n_out60p0 = clamp(n_out59p0, n_in60p1, n_in60p2);


// FloatOp:61
	float n_out61p0 = n_out10p0 * n_out60p0;


// VectorOp:8
	vec2 n_out8p0 = n_out14p0 * vec2(n_out24p0);


// VectorOp:21
	vec2 n_in21p1 = vec2(0.50000, 0.50000);
	vec2 n_out21p0 = n_out8p0 + n_in21p1;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(screen_tex_frg_6, n_out21p0);


// VectorDecompose:11
	float n_out11p0 = vec3(n_out6p0.xyz).x;
	float n_out11p1 = vec3(n_out6p0.xyz).y;
	float n_out11p2 = vec3(n_out6p0.xyz).z;


// FloatOp:62
	float n_out62p0 = n_out11p1 * n_out60p0;


// FloatOp:27
	float n_out27p0 = n_out24p0 + n_out75p0;


// VectorOp:9
	vec2 n_out9p0 = n_out14p0 * vec2(n_out27p0);


// VectorOp:22
	vec2 n_in22p1 = vec2(0.50000, 0.50000);
	vec2 n_out22p0 = n_out9p0 + n_in22p1;


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(screen_tex_frg_7, n_out22p0);


// VectorDecompose:12
	float n_out12p0 = vec3(n_out7p0.xyz).x;
	float n_out12p1 = vec3(n_out7p0.xyz).y;
	float n_out12p2 = vec3(n_out7p0.xyz).z;


// FloatOp:63
	float n_out63p0 = n_out12p2 * n_out60p0;


// VectorCompose:13
	vec3 n_out13p0 = vec3(n_out61p0, n_out62p0, n_out63p0);


// VectorOp:58
	vec3 n_out58p0 = n_out13p0 * vec3(n_out60p0);


// Input:68
	vec2 n_out68p0 = SCREEN_UV;


// Input:71
	vec2 n_out71p0 = SCREEN_PIXEL_SIZE;


// VectorOp:70
	vec2 n_out70p0 = n_out68p0 / n_out71p0;


// Input:66
	float n_out66p0 = TIME;


// FloatOp:73
	float n_in73p1 = 1.00000;
	float n_out73p0 = n_out66p0 * n_in73p1;


	float n_out65p0;
// Expression:65
	n_out65p0 = 0.0;
	{
		// Pixel coords
		vec2 ip = floor(n_out70p0);
		
		// Frame seed (discreto)
		float seed = floor(n_out73p0 * 24.0);
		
		// Mezcla (sin mover n_out70p0): convierte (x,y,seed) a un escalar bien mezclado
		// (float-only \"pcg-ish\" hash)
		vec3 p3 = fract(vec3(ip.x, ip.y, seed) * 0.1031);
		p3 += dot(p3, p3.yzx + 33.33);
		n_out65p0 = fract((p3.x + p3.y) * p3.z);
		
	}


// Mix:74
	float n_in74p1 = 1.00000;
	float n_in74p2 = 0.67000;
	float n_out74p0 = mix(n_out65p0, n_in74p1, n_in74p2);


	vec3 n_out69p0;
// ColorOp:69
	{
		float base = n_out58p0.x;
		float blend = vec3(n_out74p0).x;
		if (base < 0.5) {
			n_out69p0.x = (base * (blend + 0.5));
		} else {
			n_out69p0.x = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}
	{
		float base = n_out58p0.y;
		float blend = vec3(n_out74p0).y;
		if (base < 0.5) {
			n_out69p0.y = (base * (blend + 0.5));
		} else {
			n_out69p0.y = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}
	{
		float base = n_out58p0.z;
		float blend = vec3(n_out74p0).z;
		if (base < 0.5) {
			n_out69p0.z = (base * (blend + 0.5));
		} else {
			n_out69p0.z = (1.0 - (1.0 - base) * (1.0 - (blend - 0.5)));
		}
	}


// Output:0
	COLOR.rgb = n_out69p0;


}
"
