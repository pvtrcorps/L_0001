		n_out88p0 = vec3(max2, max2, max2);
	}


// FloatConstant:90
	float n_out90p0 = 0.200000;


// VectorOp:89
	vec3 n_out89p0 = n_out88p0 * vec3(n_out90p0);


// Reroute:33
	vec2 n_out33p0 = n_out23p0;


	bool n_out29p0;
// Compare:29
	vec2 n_in29p1 = vec2(0.00000, 0.00000);
	{
		bvec2 _bv = greaterThan(n_out33p0, n_in29p1);
		n_out29p0 = all(_bv);
	}


	bool n_out30p0;
// Compare:30
	vec2 n_in30p1 = vec2(1.00000, 1.00000);
	{
		bvec2 _bv = lessThan(n_out33p0, n_in30p1);
		n_out30p0 = all(_bv);
	}


// FloatOp:31
	float n_out31p0 = (n_out29p0 ? 1.0 : 0.0) * (n_out30p0 ? 1.0 : 0.0);


// Mix:87
	vec3 n_out87p0 = mix(n_out89p0, n_out186p0, vec3(n_out31p0));


// Output:0
	COLOR.rgb = n_out87p0;


}
